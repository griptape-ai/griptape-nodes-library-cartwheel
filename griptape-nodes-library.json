{
    "name": "Cartwheel AI Library",
    "library_schema_version": "0.5.0",
    "settings": [
        {
            "description": "API keys required by nodes in this library",
            "category": "app_events.on_app_initialization_complete",
            "contents": {
                "secrets_to_register": [
                    "CARTWHEEL_API_KEY"
                ]
            }
        }
    ],
    "metadata": {
        "author": "Andrew",
        "description": "Nodes for interacting with the Cartwheel motion orchestration API.",
        "library_version": "0.1.0",
        "engine_version": "0.73.0",
        "tags": [
            "Griptape",
            "Cartwheel",
            "Animation",
            "3D",
            "Motion"
        ],
        "dependencies": {
            "pip_dependencies": [
                "requests"
            ]
        }
    },
    "categories": [
        {
            "animation/cartwheel": {
                "color": "border-orange-500",
                "title": "Cartwheel",
                "description": "Nodes for Cartwheel character and motion generation workflows.",
                "icon": "PersonStanding"
            }
        }
    ],
    "nodes": [
        {
            "class_name": "CartwheelCreateCharacter",
            "file_path": "cartwheel/create_character.py",
            "metadata": {
                "category": "animation/cartwheel",
                "description": "Uploads a character model and thumbnail to Cartwheel, then polls until processing finishes.",
                "display_name": "Cartwheel Create Character"
            }
        },
        {
            "class_name": "CartwheelGenerateMotion",
            "file_path": "cartwheel/generate_motion.py",
            "metadata": {
                "category": "animation/cartwheel",
                "description": "Generates motion from text or a reference video, polls the batch, and downloads the resulting zip.",
                "display_name": "Cartwheel Generate Motion"
            }
        },
        {
            "class_name": "CartwheelCreateMascot",
            "file_path": "cartwheel/create_mascot.py",
            "metadata": {
                "category": "animation/cartwheel",
                "description": "Uploads mascot source assets, submits a mascot job, polls for completion, and downloads the generated output video.",
                "display_name": "Cartwheel Create Mascot"
            }
        }
    ]
}
